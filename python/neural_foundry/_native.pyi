from typing import final

class NativeError(Exception):
    code: str
    path: str
    message: str

class CancelledError(NativeError): ...
class NativePanicError(NativeError): ...

@final
class CancellationHandle:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...

@final
class RecordHandle:
    @property
    def kind(self) -> str: ...
    @property
    def digest(self) -> str: ...
    def json(self) -> bytes: ...

@final
class SourceHandle:
    @property
    def manifest_digest(self) -> str: ...
    @property
    def parameter_digest(self) -> str: ...
    def manifest_json(self) -> bytes: ...
    def forward(self, input: list[float]) -> list[float]: ...
    def tensor_bytes(self, name: str) -> bytes: ...

@final
class PlanHandle:
    @property
    def digest(self) -> str: ...
    def summary_json(self) -> bytes: ...

@final
class CandidateHandle:
    @property
    def digest(self) -> str: ...
    @property
    def parameter_digest(self) -> str: ...
    def receipt_json(self) -> bytes: ...
    def tensor_bytes(self, name: str) -> bytes: ...
    def snapshot(self, cancellation: CancellationHandle | None = None) -> SourceHandle: ...

